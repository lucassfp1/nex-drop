# URL pública final, sem barra no fim. Ex.: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4. O script só carrega quando as duas variáveis abaixo estiverem configuradas.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Meta tag de verificação do Google Search Console.
GOOGLE_SITE_VERIFICATION=
